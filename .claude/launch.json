{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "labsidian",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "scripts/serve.py",
        "8765"
      ],
      "port": 8765
    },
    {
      "name": "labsidian-demo",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "scripts/serve.py",
        "8766",
        "--demo"
      ],
      "port": 8766
    },
    {
      "name": "labsidian-wsl-lan",
      "runtimeExecutable": "wsl",
      "runtimeArgs": [
        "-d", "Ubuntu", "--", "bash", "-lc",
        "cd ~/labsidian && python3 scripts/serve.py 8780 --host 0.0.0.0"
      ],
      "port": 8780
    }
  ]
}
