  "scripts": {
    "studio": "remotion studio",
    "render": "node render.mjs",
    "render:loop": "node render.mjs Loop",
    "gif": "node render.mjs Loop && ffmpeg -y -loglevel error -i out/loop.mp4 -vf \"fps=12,scale=960:-1:flags=lanczos,split[a][b];[a]palettegen=max_colors=160[p];[b][p]paletteuse=dither=bayer:bayer_scale=5\" ../../docs/labsidian_demo.gif"
  },
